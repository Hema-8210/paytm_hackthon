# SkillPath Environment Variables Template

ENVIRONMENT=development

# Database Configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./skillpath.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Security Secret
JWT_SECRET=super-secret-skillpath-jwt-key-2026-production-ready

# OpenAI API Key (Optional: Local fallback engine handles requests if key is omitted)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Storage & Database Integration
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=skillpath-resumes

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
